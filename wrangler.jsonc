{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-news-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "triggers": {
    "crons": ["7 1,4,7,10,13 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "football-news-bot",
      "database_id": "8ccd410d-2733-4987-b16f-b2b53375d558",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RSS_FEEDS_JSON": "[{\"name\":\"BBC Sport Football\",\"url\":\"https://feeds.bbci.co.uk/sport/football/rss.xml\",\"priority\":100},{\"name\":\"Sky Sports Football\",\"url\":\"https://www.skysports.com/rss/12040\",\"priority\":80},{\"name\":\"Liverpool FC official\",\"url\":\"https://www.liverpoolfc.com/?feed=rss2\",\"priority\":70}]"
  }
}
